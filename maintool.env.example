# Instellingen van de Proxmox Maintool: /etc/maintool/maintool.env (rechten 640, eigenaar root:maintool).
# Het setup-bestand vult dit bestand zelf in; dit sjabloon is er alleen ter uitleg.
# Na een wijziging: systemctl restart maintool

# Alle nodes van het cluster, komma-gescheiden. De tool valt automatisch terug op de volgende.
PVE_HOSTS=192.168.1.11,192.168.1.12,192.168.1.13

# API-token van Proxmox (toegangssleutel). Het geheim hoort alleen hier te staan.
PVE_USER=maintool@pve
PVE_TOKEN_NAME=ct100
PVE_TOKEN_VALUE=

# Certificaat van het cluster (/etc/pve/pve-root-ca.pem van een node), om de nodes te controleren.
PVE_CA_FILE=/etc/maintool/pve-root-ca.pem
PVE_VERIFY_SSL=true

# Inlog voor de webpagina van de tool
APP_USER=admin
APP_PASSWORD=

# Weekoverzicht per mail (optioneel; zonder deze regels staat het uit). Voor Gmail: zet verificatie in twee
# stappen aan, maak onder "App-wachtwoorden" een wachtwoord aan en vul dat in (niet je gewone wachtwoord).
#MAIL_SMTP_HOST=smtp.gmail.com
#MAIL_SMTP_PORT=587
#MAIL_USER=jij@voorbeeld.nl
#MAIL_PASSWORD=
#MAIL_TO=jij@voorbeeld.nl
# Wanneer: dag (mon tue wed thu fri sat sun), tijd en tijdzone.
#REPORT_DAY=sun
#REPORT_TIME=05:00
REPORT_TZ=Europe/Amsterdam
# Guests (ID's, komma-gescheiden) waarvan bewust geen back-up wordt gemaakt; het weekoverzicht meldt die niet.
#REPORT_NO_BACKUP=
